{
	admin off
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		-Server
	}
}

# The Pi serves no UI; the dashboard lives in AWS. This is its only listener.
# Phone ingest. Only clients with a certificate signed by our own CA get through.
{$EDGE_HOSTNAME}:8443 {
	import security_headers

	tls {
		client_auth {
			mode require_and_verify
			trust_pool file /etc/caddy/client-ca.crt
		}
	}

	request_body {
		max_size 64KB
	}
	reverse_proxy ingest-api:8080
}
