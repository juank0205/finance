# Copy to .env on the Pi (git-ignored).

# Tailscale IP of the Pi (`tailscale ip -4`). Ports are bound ONLY to this IP, never 0.0.0.0.
EDGE_BIND_IP=100.64.0.10

# Tailscale MagicDNS name; Caddy gets a real HTTPS cert for it through tailscaled.
EDGE_HOSTNAME=finance-pi.your-tailnet.ts.net

# From Terraform output once the IoT module exists (phase 4).
IOT_ENDPOINT=
